# Copy this file to .env and provide a key with access to the selected model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=120

TRAIN_CASES_DIR=data/train
TEST_CASES_DIR=data/test
ARTIFACTS_DIR=artifacts
DRIVER_CATALOG_PATH=artifacts/drivers/evaluation_drivers.json
PROMPTS_DIR=prompts

PROBABILITY_SUM_TOLERANCE=0.001
ADD_REQUEST_MIN_CONFIDENCE=0.75
AUTO_APPLY_MIN_CONFIDENCE=0.90
CATALOG_LANGUAGE=ru
LOG_LEVEL=INFO
